# Yerel geliştirme örneğidir; gerçek anahtar yazmayın.
MAKI_ENVIRONMENT=development
MAKI_EXECUTION_MODE=local
MAKI_DATABASE__DSN=postgresql+asyncpg://maki:maki@localhost:5432/maki
MAKI_REDIS__DSN=redis://localhost:6379/0
MAKI_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
MAKI_SECURITY__JWT_PUBLIC_KEY=
MAKI_SECURITY__JWT_KEY_ID=primary
MAKI_SECURITY__JWT_ISSUER=maki
MAKI_SECURITY__JWT_AUDIENCE=maki-mobile
MAKI_ANTHROPIC_API_KEY=
MAKI_GEMINI_API_KEY=
MAKI_GEMINI_MODEL=gemini-3.5-flash-lite
MAKI_EVDS_API_KEY=
MAKI_WEB_ORIGINS=["https://maki.example.com"]
MAKI_BILLING__ALLOWED_PRODUCTS=["maki_debt_pro"]
MAKI_BILLING__GOOGLE_PACKAGE_NAME=com.team120.maki.maki_app
MAKI_BILLING__APPLE_BUNDLE_ID=com.team120.maki.makiApp
MAKI_BILLING__APPLE_ENVIRONMENT=Production
# Aşağıdaki değerleri yalnızca secret yöneticisinden verin; depoya yazmayın.
MAKI_BILLING__GOOGLE_SERVICE_ACCOUNT_JSON=
MAKI_BILLING__APPLE_TRUSTED_ROOT_PEM=
MAKI_BILLING__APPLE_ACCOUNT_TOKEN_SECRET=
MAKI_OCR__DETECTION_MODEL_DIR=../.local/paddle-cache/official_models/PP-OCRv6_medium_det
MAKI_OCR__RECOGNITION_MODEL_DIR=../.local/paddle-cache/official_models/PP-OCRv6_medium_rec
